! ===== Day-0 bootstrap: {{ name }} — cml_lab.py ใส่เป็น startup config ของ node ใน CML ให้อัตโนมัติ =====
! (ถ้าทำมือ: วางในแท็บ "Config" ของ node ก่อนกด Start)
hostname {{ name }}
ip domain-name {{ domain }}
no ip domain-lookup
enable secret {{ secret }}
username {{ username }} privilege 15 secret {{ password }}
interface {{ mgmt_if }}
 description OOB-MGMT
 ip address {{ mgmt_ip }} {{ mgmt_mask }}
 exit
ip route 10.10.0.0 255.255.0.0 10.10.20.254
ip route 192.168.0.0 255.255.0.0 10.10.20.254
 no shutdown
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
line con 0
 logging synchronous
line vty 0 4
 login local
 transport input ssh
end
