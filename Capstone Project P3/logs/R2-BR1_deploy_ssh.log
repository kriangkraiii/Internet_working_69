 permit icmp any any time-exceeded
 permit icmp any any echo
 deny   ip any any log
ip access-list extended CoPP-ICMP
 permit icmp any any
ip access-list extended CoPP-IPSEC
 permit udp any any eq isakmp
 permit udp any any eq non500-isakmp
 permit esp any any
ip access-list extended CoPP-MGMT
 permit tcp 10.10.20.0 0.0.0.255 any eq 22
 permit udp 10.10.20.0 0.0.0.255 any eq snmp
 permit udp 10.10.20.0 0.0.0.255 any eq ntp
 permit udp 10.10.20.0 0.0.0.255 eq ntp any
 permit tcp any any eq 22
ip access-list extended CoPP-ROUTING
 permit ospf any any
!
logging source-interface GigabitEthernet0/3
logging host 10.10.20.50
ipv6 router ospf 1
 router-id 2.2.2.2
 passive-interface default
 no passive-interface Tunnel12
!
